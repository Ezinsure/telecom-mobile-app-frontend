{
  "expo": {
    "name": "solektra-app",
    "slug": "solektra-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "solektraapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.solektra.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
 "icon": "./assets/images/icon.png",
"android": {
  "adaptiveIcon": {
    "backgroundColor": "#E6F4FE",
    "foregroundImage": "./assets/images/android-icon-foreground.png"
  },
  "predictiveBackGestureEnabled": false,
  "package": "com.solektra.app"
},
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9fc03e5-7fb2-4432-8aee-7497253799dc"
      }
    }
  }
}
